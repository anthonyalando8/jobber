# Database
DATABASE_URL=postgres://user:pass@localhost:5432/prospector?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# HTTP
HTTP_ADDR=:8080

# SMTP - Gmail with APP PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anthonyalando8@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_NAME=Anthony Alando
FROM_EMAIL=anthonyalando8@gmail.com
REPLY_TO=anthonyalando8@gmail.com

# AI Provider (choose one: Claude OR Gemini)
# Claude API (priority if both set)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OR Google Gemini API (fallback if Claude not set). GEMINI_API_KEY accepts a single key or a
# comma-separated pool of several — Google's free-tier quota (5 requests/minute) is per key/per
# project, so pooling multiple keys multiplies real throughput. Get extra keys by creating
# separate API keys in different Google Cloud projects at aistudio.google.com/apikey.
GEMINI_API_KEY=key1,key2,key3,key4
GEMINI_MODEL=gemini-3.5-flash

# Guardrails
DAILY_SEND_LIMIT=20
MIN_SEND_INTERVAL_SECONDS=90
CRAWL_DELAY_MS=1200
CRAWL_USER_AGENT=prospector/1.0 (+mailto:anthonyalando8@gmail.com)

# Minimum seconds between drafting API calls within one "Draft Enriched" batch. Leave unset to
# auto-pace from the provider: Gemini computes ~13s divided across however many keys are pooled
# in GEMINI_API_KEY (1 key = 13s, 4 keys = ~3.25s); Claude needs no pacing. Set explicitly only
# to override that.
# DRAFT_MIN_INTERVAL_SECONDS=13

# Autonomous worker (internal/worker) — ticker-driven discovery/verify/research loops that run
# continuously alongside the HTTP server. Defaults match internal/worker.DefaultConfig().
# How often the discovery loop seeds from job boards, then verifies any unverified domains.
# DISCOVERY_INTERVAL_MINUTES=20
# How often the research loop enriches a small batch of verified/manual-domain companies.
# RESEARCH_INTERVAL_SECONDS=30
# How long after a research attempt before a company is eligible to be researched again.
# RESEARCH_TTL_HOURS=24
# How often the draft loop checks whether it's allowed to spend one more AI call (the actual
# pacing between calls is AI_DRAFT_COOLDOWN_SECONDS below, not this).
# DRAFT_INTERVAL_SECONDS=60

# AI generation budget (internal/aibudget) — treats AI drafting as a scarce resource shared by
# the manual "Draft Enriched" button, the single-company draft button, and the autonomous
# worker. Exhausting it never fails the pipeline — research and scoring keep running regardless.
# AI_ENABLED=true
# AI_DRAFTS_PER_HOUR=5
# AI_DRAFTS_PER_DAY=30
# Score floor below which a company is never offered to the AI at all (applies to the
# autonomous worker and the manual batch button — not the single-company button, where a human
# already exercised judgment by picking that company).
# AI_MIN_SCORE=70
# Minimum time between the *autonomous* worker's own AI calls — quality over volume (review.md
# §45). Doesn't apply to a human explicitly clicking a draft button.
# AI_DRAFT_COOLDOWN_SECONDS=600

# Send policy (internal/sendpolicy) — the AUTO_SEND / REVIEW_REQUIRED / BLOCKED decision made
# for every drafted email. AUTO_SEND really does send, unattended, through the same guarded
# executeSend() path a human's "Send" button uses — this is the one setting that turns
# unattended outreach on. Leave AUTO_SEND_ENABLED=false (or set AUTO_SEND_MIN_SCORE above 100)
# if you want every draft to land in /review regardless of confidence.
# AUTO_SEND_ENABLED=true
# AUTO_SEND_MIN_SCORE=80
# REVIEW_MIN_SCORE=65
# AUTO_SEND_REQUIRE_FRESH_EVIDENCE=true
# AUTO_SEND_MAX_EVIDENCE_AGE_HOURS=72

# Search-based domain resolution (internal/domainsearch) — for companies stuck at
# domain_status='failed' after every guessed candidate (verify.CandidateDomains) came up empty.
# Free HTML-scraping of DuckDuckGo/Bing was tried and rejected (both blocked plain scraped
# requests in testing), so this uses Google's real Custom Search JSON API instead:
#   1. console.cloud.google.com -> enable "Custom Search API", create an API key
#   2. programmablesearchengine.google.com -> create a search engine, set it to search the
#      entire web (not just specific sites)
# Leave both unset to disable this feature entirely — every caller treats "not configured" as a
# no-op, the same way an unconfigured AI provider just skips drafting rather than erroring.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# 100 queries/day are free, then $5/1000. Default below leaves headroom under the free tier.
# GOOGLE_SEARCH_DAILY_LIMIT=90
# How often the autonomous worker *checks* whether there's budget/backlog to spend — the daily
# query budget above is what actually limits real spend, not this.
# DOMAIN_RESOLVE_INTERVAL_MINUTES=30

# Required before any "hiring_us" (RemoteOK-sourced, US/international remote) email can be
# drafted at all — CAN-SPAM requires a valid physical postal address in every commercial email
# sent to a US recipient. internal/draft/generate.go refuses outright (skips to needs_manual,
# no AI call spent) rather than send a non-compliant email while this is unset. A street address,
# PO box, or registered private mailbox all satisfy the requirement — it does not need to be a
# business address.
# US_MAILING_ADDRESS=123 Example St, Nairobi, Kenya

# V2 rollout: keep review-only until approved offline evaluation is complete.
# Phase 1 additionally has a code-level interlock: no AI generation, workers, or sends.
EMAIL_PIPELINE_MODE=v2_review

# Phase 4 manual composition only. SMTP, follow-ups and scheduler remain interlocked.
EMAIL_COMPOSITION_ENABLED=false
# Routes are independent; set explicit available models before manual generation.
EMAIL_COMPOSE_PROVIDER=
EMAIL_COMPOSE_MODEL=
EMAIL_REVIEW_PROVIDER=
EMAIL_REVIEW_MODEL=
# Explicit quotas cover composition, semantic review and repairs. Zero disables calls.
# Initial runs reserve six requests; edits reserve one review request.
AI_REQUESTS_PER_HOUR=0
AI_REQUESTS_PER_DAY=0
AUTO_SEND_INTENTS=

# --- Selective automation (Phase 7) -------------------------------------------------
# Automation is a decision layer over the reviewed pipeline, never a second pipeline.
# Every message is still matched, composed, validated, reviewed, approved and preflighted.
#
# EMAIL_PIPELINE_MODE: disabled | v2_review | v2_manual_send | v2_auto
#   v2_review      inspect, match, compose, validate, review. No sending. (default)
#   v2_manual_send a person may approve and send one reviewed draft at a time.
#   v2_auto        additionally consults the automation policy. It does NOT mean
#                  eligible drafts are sent: the policy decides each message.
#
# AUTO_SEND_INTENTS: comma-separated intents that may even be considered. Empty means
#   nothing is ever sent automatically. "all" and wildcards are refused. Only
#   specific_job_application is automatable at all; naming any other intent, or an
#   unknown value, stops startup rather than being ignored.
AUTO_SEND_INTENTS=
#
# AUTO_SEND_DAILY_CAP: automation-specific cap, separate from DAILY_SEND_LIMIT. This is
#   for controlled observation, not throughput; values above 5 are refused.
AUTO_SEND_DAILY_CAP=1
