# Prospector production configuration.
# Copy to .env.production next to docker-compose.yaml, fill in, then: chmod 600 .env.production
# Never commit the filled-in file. Every value below is a placeholder.

# --- Admin access ------------------------------------------------------------------------------
# The single key that unlocks the application. At least 32 characters; generate with:
#   openssl rand -base64 48
# Changing it and restarting the app signs out every existing session.
ADMIN_ACCESS_KEY=
# Session lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168
# Keep true. Set false only when browsing over plain HTTP to an address other than localhost.
# COOKIE_SECURE=true

# --- Database (dedicated cluster in the db container) ----------------------------------------
# A new password for this application only; never reuse another application's credentials.
POSTGRES_USER=prospector
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=prospector
# Must use the same user/password as above. Host "db" is the compose service name.
DATABASE_URL=postgres://prospector:change-me-to-a-long-random-password@db:5432/prospector?sslmode=disable

# REDIS_URL, HTTP_ADDR and TZ are set by docker-compose.yaml.

# --- Rollout ----------------------------------------------------------------------------------
# disabled | v2_review | v2_manual_send | v2_auto
EMAIL_PIPELINE_MODE=v2_manual_send
# Empty: nothing is ever sent automatically. Even when set, automatic sending also needs the
# dashboard switch (Automation card), which starts off.
AUTO_SEND_INTENTS=
# At most 20. Start with 1-2 and raise it after watching what is sent.
AUTO_SEND_DAILY_CAP=1
# Spreads automatic sends across the day (default 1 per hour).
AUTO_SEND_HOURLY_CAP=1

# --- AI composition ---------------------------------------------------------------------------
EMAIL_COMPOSITION_ENABLED=true
AI_REQUESTS_PER_HOUR=18
AI_REQUESTS_PER_DAY=60
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Gemini pool (comma-separated keys).
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional explicit routes; inferred from the keys above when unset.
# EMAIL_COMPOSE_PROVIDER=
# EMAIL_COMPOSE_MODEL=
# EMAIL_REVIEW_PROVIDER=
# EMAIL_REVIEW_MODEL=

# --- Autonomous workers (all off until switched on from the dashboard) ----------------------
# Drafts the outreach worker may start per day (each uses up to six AI requests).
OUTREACH_DAILY_DRAFTS=3
# AI opinions on discovered contact addresses per day (the free check is unlimited).
ADDRESS_AI_DAILY=20
# How often each worker looks for work.
# TRIAGE_INTERVAL_MINUTES=10
# OUTREACH_INTERVAL_MINUTES=30
# ADDRESS_CHECK_INTERVAL_MINUTES=15

# --- Email (Gmail with an app password) -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
FROM_NAME=Your Name
FROM_EMAIL=you@example.com
REPLY_TO=you@example.com
DAILY_SEND_LIMIT=20
MIN_SEND_INTERVAL_SECONDS=90

# --- Crawling ---------------------------------------------------------------------------------
CRAWL_USER_AGENT=prospector/1.0 (+mailto:you@example.com)
CRAWL_DELAY_MS=1200

# --- Optional: Google Custom Search (domain resolution and contact discovery) -----------------
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
# GOOGLE_SEARCH_DAILY_LIMIT=90

# --- Optional worker tuning (defaults shown; see .env.example for the full list) --------------
# DISCOVERY_INTERVAL_MINUTES=20
# SOURCE_INTERVAL_MINUTES=180
# ATS_BOARDS=greenhouse:gitlab,lever:example
# RESEARCH_INTERVAL_SECONDS=30
# RESEARCH_TTL_HOURS=24
# DOMAIN_RESOLVE_INTERVAL_MINUTES=30
# CONTACT_DISCOVERY_INTERVAL_MINUTES=45
# SUPPRESSION_INTERVAL_MINUTES=360
